Функция Услуга(Код, Название, Описание, ЦенаСедана, ЦенаКроссовера, ЦенаВнедорожника)
    Цены = Новый Массив;
    Цены.Добавить(ЦенаСедана);
    Цены.Добавить(ЦенаКроссовера);
    Цены.Добавить(ЦенаВнедорожника);
    Возврат Новый Структура("id,name,description,prices", Код, Название, Описание, Цены);
КонецФункции

Классы = Новый Массив;
Классы.Добавить("Седан / хэтчбек");
Классы.Добавить("Кроссовер");
Классы.Добавить("Крупный внедорожник");

Услуги = Новый Массив;
Услуги.Добавить(Услуга("polish", "Полировка кузова",
    "Для потускневшего лака и мелких следов моек. Очистка поверхности и восстановительная полировка.", 12000, 15000, 18000));
Услуги.Добавить(Услуга("interior", "Химчистка салона",
    "Для глубокой очистки салона. Обработка обивки, ковров и пластика с последующей сушкой.", 8000, 10000, 12000));
Услуги.Добавить(Услуга("ceramic", "Керамическая защита",
    "Для защиты лакового покрытия. Включает базовую подготовку и нанесение состава. Полировка оплачивается отдельно.", 18000, 22000, 26000));

// Индекс строки — маска выбранных услуг. В браузере доступен весь учебный прайс.
Варианты = Новый Массив;
Варианты.Добавить(Новый Массив);
Для Индекс = 0 По Услуги.Количество() - 1 Цикл
    КоличествоВариантов = Варианты.Количество();
    Для Маска = 0 По КоличествоВариантов - 1 Цикл
        ВыборУслуг = Новый Массив;
        Для Каждого ВыбраннаяУслуга Из Варианты[Маска] Цикл
            ВыборУслуг.Добавить(ВыбраннаяУслуга);
        КонецЦикла;
        ВыборУслуг.Добавить(Индекс);
        Варианты.Добавить(ВыборУслуг);
    КонецЦикла;
КонецЦикла;

Итоги = Новый Массив;
Для Класс = 0 По Классы.Количество() - 1 Цикл
    СтрокаИтогов = Новый Массив;
    Для Каждого Вариант Из Варианты Цикл
        Сумма = 0;
        Для Каждого Индекс Из Вариант Цикл
            Сумма = Сумма + Услуги[Индекс].prices[Класс];
        КонецЦикла;
        СтрокаИтогов.Добавить(Сумма);
    КонецЦикла;
    Итоги.Добавить(СтрокаИтогов);
КонецЦикла;

Форматы = Новый Структура;
Форматы.Вставить("explain", Новый Структура("title,description", "Лендинг",
    "Одна страница с предложением, ответами на вопросы и кнопкой обращения."));
Форматы.Вставить("compare", Новый Структура("title,description", "Сайт компании",
    "Отдельные страницы услуг, примеры работ и общий путь к обращению."));
Форматы.Вставить("estimate", Новый Структура("title,description", "Калькулятор или конфигуратор",
    "Выбор параметров, прозрачный расчёт и сводка перед обращением."));

Форматы.Вставить("dialog", Новый Структура("title,description", "Telegram-бот",
    "Сценарий диалога, ответы на вопросы и переход к услуге."));

Данные = Новый Структура("vehicles,services,totals,brief", Классы, Услуги, Итоги, Форматы);
Запись = Новый ЗаписьJSON;
Запись.УстановитьСтроку();
ЗаписатьJSON(Запись, Данные);
Сообщить(Запись.Закрыть());
